---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable">
  <section class="bg-grid flex min-h-[60vh] flex-col items-center justify-center px-4 py-24 text-center">
    <p class="font-display text-7xl font-extrabold text-gradient">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-ink">Game over… cette page n'existe pas.</h1>
    <a href="/" class="btn-primary mt-8 inline-block">Retour à l'accueil</a>
  </section>
</Layout>
