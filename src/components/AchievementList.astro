---
import { isWin, type Achievement } from '../lib/content';

interface Props {
  achievements: Achievement[];
}
const { achievements } = Astro.props;

// Regroupe par année, les plus récentes d'abord.
const byYear = Map.groupBy(achievements, (a) => a.year);
---

<div class="space-y-10">
  {[...byYear].map(([year, items]) => (
    <div class="grid gap-4 md:grid-cols-[120px_1fr]">
      <p class="font-display text-3xl font-extrabold text-ink/15 md:text-right">{year}</p>
      <ul class="space-y-3">
        {items.map((a) => (
          <li class="flex flex-col gap-2 rounded-xl border border-ink/10 bg-paper px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-bold text-ink">{a.competition}</p>
              {(a.game || a.players) && (
                <p class="text-base text-ink-soft">{[a.game, a.players].filter(Boolean).join(' · ')}</p>
              )}
            </div>
            <span class={`self-start rounded-full px-4 py-1 text-sm font-bold uppercase tracking-wider sm:self-auto ${isWin(a.result) ? 'bg-ink text-cream' : 'bg-ink/5 text-ink-soft'}`}>
              {isWin(a.result) ? '🏆 ' : ''}{a.result}
            </span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
