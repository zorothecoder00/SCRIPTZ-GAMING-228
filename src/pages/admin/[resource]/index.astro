---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { cellValue, deleteRow, getResource, listRows } from '../../../lib/admin-resources';

const key = Astro.params.resource!;
const resource = getResource(key);
if (!resource) return new Response(null, { status: 404 });

let notice = Astro.url.searchParams.get('ok') ? 'Enregistré ✔' : '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const id = Number(data.get('id'));
  if (data.get('action') === 'delete' && Number.isInteger(id)) {
    await deleteRow(resource, id);
    notice = 'Supprimé ✔';
  }
}

const rows = await listRows(resource);
const columns = resource.columns.map((name) => resource.fields.find((f) => f.name === name)!);
---

<AdminLayout title={`${resource.icon} ${resource.label}`}>
  {!resource.readOnly && (
    <a slot="actions" href={`/admin/${key}/nouveau`} class="btn-primary !px-5 !py-2 text-sm">+ Ajouter un {resource.singular}</a>
  )}

  {notice && <p class="mb-6 rounded-md bg-ink px-4 py-2 font-semibold text-cream">{notice}</p>}

  {rows.length ? (
    <div class="overflow-x-auto rounded-xl border border-ink/10 bg-paper">
      <table class="w-full text-left">
        <thead class="border-b border-ink/10 text-sm uppercase tracking-wider text-ink-muted">
          <tr>
            {columns.map((c) => <th class="px-5 py-3 font-semibold">{c.label}</th>)}
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink/10">
          {rows.map((row) => (
            <tr class="hover:bg-ink/[0.03]">
              {columns.map((c, i) => (
                <td class="px-5 py-3">
                  {i === 0 ? (
                    <a href={`/admin/${key}/${row.id}`} class="font-semibold text-ink hover:text-brand">{cellValue(row[c.name])}</a>
                  ) : (
                    <span class="text-ink-soft">{cellValue(row[c.name])}</span>
                  )}
                </td>
              ))}
              <td class="px-5 py-3 text-right whitespace-nowrap">
                <a href={`/admin/${key}/${row.id}`} class="mr-4 text-sm font-bold uppercase tracking-wider text-ink-soft hover:text-brand">
                  {resource.readOnly ? 'Lire' : 'Modifier'}
                </a>
                <form method="POST" class="inline" data-confirm={`Supprimer ce ${resource.singular} ?`}>
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={row.id} />
                  <button class="text-sm font-bold uppercase tracking-wider text-brand/80 hover:text-brand">Supprimer</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="rounded-xl border border-dashed border-ink/15 px-6 py-12 text-center text-ink-muted">
      Aucun {resource.singular} pour le moment.
    </p>
  )}
</AdminLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) =>
    form.addEventListener('submit', (e) => {
      if (!confirm(form.dataset.confirm)) e.preventDefault();
    }),
  );
</script>
