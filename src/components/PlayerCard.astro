---
import Flag from './Flag.astro';
import type { Player } from '../lib/content';

interface Props {
  player: Player;
}
const { player } = Astro.props;

const socials = [
  ['Instagram', player.instagram],
  ['TikTok', player.tiktok],
  ['X', player.twitter],
  ['Twitch', player.twitch],
  ['YouTube', player.youtube],
].filter((s): s is [string, string] => Boolean(s[1]));
---

<article class="group relative overflow-hidden rounded-xl border border-ink/10 bg-paper transition hover:-translate-y-1 hover:border-brand/50">
  <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-b from-cream-dark to-paper">
    {player.photo_url ? (
      <img
        src={player.photo_url}
        alt={player.pseudo}
        loading="lazy"
        class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="grid h-full place-items-center font-display text-7xl font-extrabold text-ink/10">
        {player.pseudo.slice(0, 2).toUpperCase()}
      </div>
    )}
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-paper to-transparent"></div>
    <span class="absolute top-3 right-3 rounded-full bg-ink/85 px-3 py-1 text-xs font-bold uppercase tracking-wider text-cream backdrop-blur">
      {player.game}
    </span>
  </div>
  <div class="relative -mt-10 p-5">
    <h3 class="font-display text-xl font-bold text-ink group-hover:text-brand">
      {player.pseudo} <Flag code={player.country} class="ml-1" />
    </h3>
    {(player.real_name || player.role) && (
      <p class="mt-1 text-ink-soft">{[player.real_name, player.role].filter(Boolean).join(' · ')}</p>
    )}
    {player.bio && <p class="mt-3 line-clamp-3 text-base text-ink-soft">{player.bio}</p>}
    {socials.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {socials.map(([label, url]) => (
          <a href={url} target="_blank" rel="noopener" class="rounded-md border border-ink/15 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-ink-soft transition hover:border-brand hover:text-brand">
            {label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
