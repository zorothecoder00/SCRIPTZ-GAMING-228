---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Layout title="Actualités" description="Annonces, résultats et coulisses de Scriptz Gaming 228.">
  <PageHeader eyebrow="News" title="Les" accent="actualités" intro="Annonces, résultats de matchs et coulisses de l'équipe." />

  <div class="mx-auto max-w-6xl px-4 py-20">
    {posts.length ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    ) : (
      <EmptyState icon="📰" text="Aucune actualité pour le moment." />
    )}
  </div>
</Layout>
