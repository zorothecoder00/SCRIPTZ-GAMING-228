---
import { flag, type Player } from '../lib/content';

interface Props {
  player: Player;
}
const { player } = Astro.props;

const socials = [
  ['Instagram', player.instagram],
  ['TikTok', player.tiktok],
  ['X', player.twitter],
  ['Twitch', player.twitch],
  ['YouTube', player.youtube],
].filter((s): s is [string, string] => Boolean(s[1]));
---

<article class="group relative overflow-hidden rounded-xl border border-white/5 bg-night-800 transition hover:-translate-y-1 hover:border-neon-green/50">
  <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-b from-neon-purple/25 to-night-900">
    {player.photo_url ? (
      <img
        src={player.photo_url}
        alt={player.pseudo}
        loading="lazy"
        class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="grid h-full place-items-center font-display text-7xl font-extrabold text-white/10">
        {player.pseudo.slice(0, 2).toUpperCase()}
      </div>
    )}
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-night-800 to-transparent"></div>
    <span class="absolute top-3 right-3 rounded-full bg-night-950/70 px-3 py-1 text-xs font-bold uppercase tracking-wider text-neon-green backdrop-blur">
      {player.game}
    </span>
  </div>
  <div class="relative -mt-10 p-5">
    <h3 class="font-display text-xl font-bold text-white group-hover:text-neon-green">
      {player.pseudo} <span class="text-base">{flag(player.country)}</span>
    </h3>
    {(player.real_name || player.role) && (
      <p class="mt-1 text-zinc-400">{[player.real_name, player.role].filter(Boolean).join(' · ')}</p>
    )}
    {player.bio && <p class="mt-3 line-clamp-3 text-base text-zinc-400">{player.bio}</p>}
    {socials.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {socials.map(([label, url]) => (
          <a href={url} target="_blank" rel="noopener" class="rounded-md border border-white/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-zinc-300 transition hover:border-neon-green hover:text-neon-green">
            {label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
