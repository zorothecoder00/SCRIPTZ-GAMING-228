---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Scriptz Gaming 228',
  description = 'Scriptz Gaming 228 — la communauté gaming du Togo : tournois, streams et esport.',
} = Astro.props;

const { user } = Astro.locals;

const links = [
  { href: '/#jeux', label: 'Jeux' },
  { href: '/#tournois', label: 'Tournois' },
  { href: '/#communaute', label: 'Communauté' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07070c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Rajdhani:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-white/5 bg-night-950/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/" class="font-display text-lg font-extrabold tracking-wider text-white">
          SCRIPTZ<span class="text-neon-green">228</span>
        </a>
        <ul class="hidden gap-8 text-sm font-semibold uppercase tracking-widest md:flex">
          {links.map((l) => (
            <li><a href={l.href} class="transition hover:text-neon-green">{l.label}</a></li>
          ))}
        </ul>
        {user ? (
          <a
            href="/compte"
            class="flex items-center gap-2 rounded-md border border-white/10 px-3 py-2 text-sm font-bold text-white transition hover:border-neon-green hover:text-neon-green"
          >
            <span class="grid h-6 w-6 place-items-center rounded-full bg-neon-purple text-xs text-white">{user.name.charAt(0).toUpperCase()}</span>
            <span class="max-w-32 truncate">{user.name}</span>
          </a>
        ) : (
          <div class="flex items-center gap-4">
            <a href="/connexion" class="hidden text-sm font-bold uppercase tracking-wider transition hover:text-neon-green sm:block">Connexion</a>
            <a
              href="/inscription"
              class="rounded-md border border-neon-green px-4 py-2 text-sm font-bold uppercase tracking-wider text-neon-green transition hover:bg-neon-green hover:text-night-950"
            >
              Rejoindre
            </a>
          </div>
        )}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/5 py-10 text-center text-sm text-zinc-500">
      <p class="font-display tracking-wider text-zinc-400">SCRIPTZ GAMING 228</p>
      <p class="mt-2">© {new Date().getFullYear()} — Made in Togo 🇹🇬</p>
    </footer>
  </body>
</html>
