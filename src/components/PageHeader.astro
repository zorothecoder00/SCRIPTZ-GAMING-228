---
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  intro?: string;
}
const { eyebrow, title, accent, intro } = Astro.props;
---

<section class="bg-grid relative overflow-hidden border-b border-white/5">
  <div class="pointer-events-none absolute -top-32 left-1/2 h-[360px] w-[700px] -translate-x-1/2 rounded-full bg-neon-purple/15 blur-3xl"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-20">
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.25em] text-neon-green">{eyebrow}</p>}
    <h1 class="mt-2 font-display text-4xl font-extrabold text-white md:text-5xl">
      {title} {accent && <span class="text-gradient">{accent}</span>}
    </h1>
    {intro && <p class="mt-4 max-w-2xl text-xl text-zinc-400">{intro}</p>}
  </div>
</section>
