---
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, accent, href, linkLabel = 'Tout voir' } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.25em] text-neon-green">{eyebrow}</p>}
    <h2 class="mt-2 font-display text-3xl font-extrabold text-white md:text-4xl">
      {title} {accent && <span class="text-gradient">{accent}</span>}
    </h2>
  </div>
  {href && (
    <a href={href} class="font-bold uppercase tracking-wider text-zinc-400 transition hover:text-neon-green">
      {linkLabel} →
    </a>
  )}
</div>
